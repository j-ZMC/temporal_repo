# Copy this file to .env.local and add your real key (never push it to GitHub)
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-20b; change it if Groq retires that model.
GROQ_MODEL=
# Used to embed job-search phrases; keep the real key in .env.local.
OPENAI_API_KEY=
# Optional. Set to a Python interpreter with backend/requirements.txt installed.
PYTHON_EXECUTABLE=
