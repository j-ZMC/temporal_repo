{
  "schema_version": "1.0",
  "purpose": "Optional user-controlled signals for reviewing potential job-environment barriers in vacancy text.",
  "keyword_language": "en",
  "display_language": "en",
  "usage_policy": {
    "not_diagnostic": true,
    "do_not_infer_or_assign_neurotype": true,
    "user_selects_relevant_barriers": true,
    "interpretation": "Terms describe possible job demands or environments, not traits shared by everyone in a category. A match should be a review signal, not an automatic exclusion or a claim that a job is unsuitable.",
    "individual_variability": "People differ; co-occurring conditions, context, requested accommodations, and personal preferences matter more than a category label.",
    "term_matching": "candidate_terms_en are examples of wording commonly used in job postings and workplace descriptions. The filter compares semantic embeddings of the subtype and these phrases with the full job description; it does not require an exact keyword match. Results are signals and can include false positives or miss relevant jobs.",
    "language_note": "All category names, subtype labels, and vacancy terms are in English to match the current USA job corpus."
  },
